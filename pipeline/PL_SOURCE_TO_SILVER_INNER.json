{
	"name": "PL_SOURCE_TO_SILVER_INNER",
	"properties": {
		"activities": [
			{
				"name": "Get Table Details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.table_config WHERE TABLE_ID=@{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DSSQLServerSumoCare",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "start_time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start_time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Landing To Bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "SourceType",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/sumocare-repo/sumocare-adb/Landing_To_Bronze",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Get Table Details').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Get Table Details').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LSAzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Bronze To Silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Landing To Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/sumocare-repo/sumocare-adb/Bronze_To_Silver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Get Table Details').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						},
						"merge_keys": {
							"value": "@coalesce(activity('Get Table Details').output.firstRow.merge_keys,'')",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Get Table Details').output.firstRow.load_type",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LSAzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Success Status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Bronze To Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LSSqlDatabase",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE CTRL.audit_log\nSET STATUS='Success',END_TIME=SYSUTCDATETIME(),records_written=@{activity('Bronze To Silver').output.runOutput}\nWHERE ADF_RUN_ID='@{pipeline().parameters.adf_run_id}' and TABLE_ID=@{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get Table Details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "start_time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Get Table Details').output.firstRow.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "ReadWaterMarkValue",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT WATERMARK_VALUE FROM CTRL.WATERMARK WHERE TABLE_ID=@{pipeline().parameters.table_id}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DSSQLServerSumoCare",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Set variable1",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "ReadWaterMarkValue",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark_value",
								"value": {
									"value": "@activity('ReadWaterMarkValue').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Update the Watermark for Incremental Load",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Bronze To Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Get Table Details').output.firstRow.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "UpdateWatermark",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LSSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update ctrl.watermark set watermark_value=sysutcdatetime() where table_id=@{pipeline().parameters.table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "SourceType",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "If Condition1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('Get Table Details').output.firstRow.source_system",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "neon_postgres",
							"activities": [
								{
									"name": "SourceToLanding",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "select * from public.@{activity('Get Table Details').output.firstRow.source_table_name}\n@{\nif(equals(activity('Get Table Details').output.firstRow.load_type,'FULL'),'',concat('where',activity('Get Table Details').output.firstRow.watermark_column, '>','''',variables('watermark_value'),'''')\n) \n}\n",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobStorageWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DSPostgreSqlSumoCare",
											"type": "DatasetReference"
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_Parquet",
											"type": "DatasetReference",
											"parameters": {
												"Container": "landing",
												"Folder": {
													"value": "@concat(\nactivity('Get Table Details').output.firstRow.source_system,\n'/',\nactivity('Get Table Details').output.firstRow.source_table_name,\n'/',\nvariables('start_time')\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						},
						{
							"value": "adls_csv"
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string"
			},
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"start_time": {
				"type": "String"
			},
			"watermark_value": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-25T17:20:26Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}