{
	"name": "PL_SOURCE_TO_SILVER",
	"properties": {
		"activities": [
			{
				"name": "Read Source Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT TABLE_ID FROM ctrl.table_config WHERE IS_ACTIVE=1 AND SOURCE_SYSTEM='@{pipeline().parameters.source_system}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DSSQLServerSumoCare",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Ingest All Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read Source Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read Source Tables').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Execute Pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "InsertInProgressStatus",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_SOURCE_TO_SILVER_INNER",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_id": {
										"value": "@item().table_id",
										"type": "Expression"
									},
									"adf_run_id": {
										"value": "@pipeline().parameters.adf_run_id",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "InsertInProgressStatus",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LSSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "INSERT INTO ctrl.AUDIT_LOG(adf_run_id,table_id,stage,status,start_time)\nvalues('@{pipeline().parameters.adf_run_id}',@{item().table_id},'Source_To_Silver','In_Progress',sysutcdatetime())",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Update Failed Status",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Execute Pipeline",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LSSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE CTRL.audit_log\nSET STATUS='Failed',END_TIME=SYSUTCDATETIME()\nWHERE ADF_RUN_ID='@{pipeline().parameters.adf_run_id}' and TABLE_ID=@{item().table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"source_system": {
				"type": "string",
				"defaultValue": "adls_csv"
			},
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a8"
			}
		},
		"variables": {
			"test": {
				"type": "Integer"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-25T16:13:02Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}